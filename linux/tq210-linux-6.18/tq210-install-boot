#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Explicit initial boot installation, never overwrite existing FIT.
# Run on the Linux console after pushing the host-built files to /tmp.
set -eu
[ "$#" = 1 ] && [ "$1" = --install-boot ] || {
    echo "Usage: tq210-install-boot --install-boot"; exit 2;
}
[ "$(cat /etc/tq210-rootfs-ready 2>/dev/null)" = TQ210-NAND-ROOTFS-V1 ] ||
    { echo "Refused: expected NAND rootfs"; exit 1; }
grep -q '^ubi0:rootfs / ubifs rw,' /proc/mounts ||
    { echo "Refused: rootfs not mounted RW"; exit 1; }
fit=/tmp/tq210.itb
[ -s "$fit" ] && [ "$(wc -c < "$fit")" -le 33554432 ] ||
    { echo "Refused: missing or oversized FIT"; exit 1; }
[ -x /tmp/tq210-ubi ] || { echo "Missing updated UBI helper"; exit 1; }
/tmp/tq210-ubi attach
/tmp/tq210-ubi create-boot
[ "$(cat /sys/class/ubi/ubi0_2/name)" = boot ] || exit 1
mkdir -p /boot
if grep -q ' /boot ' /proc/mounts; then
    echo "Refused: /boot is already mounted"; exit 1
fi
[ -z "$(ls -A /boot)" ] || { echo "Refused: /boot directory not empty"; exit 1; }
mount -t ubifs ubi0:boot /boot
trap 'sync; umount /boot || :' EXIT
[ -z "$(ls -A /boot)" ] || { echo "Refused: boot volume not empty"; exit 1; }
cp "$fit" /boot/tq210-new.itb
[ "$(wc -c < /boot/tq210-new.itb)" = "$(wc -c < "$fit")" ] || exit 1
sync
mv /boot/tq210-new.itb /boot/tq210.itb
sync
echo "BOOT FIT INSTALL PASS; /boot mounted for readback verification"
trap - EXIT
