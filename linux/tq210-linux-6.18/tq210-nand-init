#!/bin/sh
# PID 1 after switch_root. dev/proc/sys/tmp inherited from RAM init.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root TERM=vt100
export PS1='root@tq210-nand:\w# '
hostname tq210
mkdir -p /mnt/nand /run
mount -t tmpfs tmpfs /run || echo "run tmpfs mount failed"
if [ "$(cat /sys/class/ubi/ubi0_0/name 2>/dev/null)" = data ]; then
    mount -t ubifs ubi0:data /mnt/nand || echo "data mount failed (rootfs remains available)"
fi
# Probe existing boot volume read-only first: never autoformat an empty one.
if [ "$(cat /sys/class/ubi/ubi0_2/name 2>/dev/null)" = boot ]; then
    if mkdir -p /boot && [ -z "$(ls -A /boot)" ] &&
       mount -t ubifs -o ro ubi0:boot /boot; then
        if [ -s /boot/tq210.itb ] || [ -s /boot/tq210-backup.itb ]; then
            mount -o remount,rw /boot || echo "boot volume remains read-only"
        else
            umount /boot
            echo "boot volume has no FIT; left unmounted"
        fi
    else
        echo "boot mount failed (rootfs remains available)"
    fi
fi
cd /root
echo
echo "========================================"
echo " TQ210 Linux NAND rootfs"
uname -a
echo " PID 1 running from UBIFS"
echo "========================================"
while :; do
    setsid cttyhack /bin/sh -i
    echo "Shell exited; restarting in one second"
    sleep 1
done
